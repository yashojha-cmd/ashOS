    <!-- Onboarding -->
    <string name="onb1_title">Meet ASH.</string>
    <string name="onb1_body">You live. ASH remembers. Bills, documents, deliveries and deadlines, organised in one calm place.</string>
    <string name="onb2_title">Your digital life, organised.</string>
    <string name="onb2_body">ASH turns the notifications you allow into clear records and tells you what needs your attention, without you having to remember where it came from.</string>
    <string name="onb3_title">Your data stays on this device.</string>
    <string name="onb3_body">ASH has no internet permission. No cloud, no accounts, no analytics. Everything is encrypted on your phone, and you can delete it all at any time.</string>
    <string name="onb4_title">Choose what ASH can access.</string>
    <string name="onb4_body">You decide which apps ASH may read. Everything is optional and you can change it later in Settings.</string>

    <!-- Permissions -->
    <string name="perm_title">Choose access</string>
    <string name="perm_intro">ASH works without any of these. Each one adds something, and you can turn it off later.</string>
    <string name="perm_notifications_header">Notifications</string>
    <string name="perm_notifications_footer">With notification access, Android lets ASH see notifications from apps you turn on below, such as bank SMS, Amazon or IRCTC. ASH reads them on this phone and never sends them anywhere. OTPs and passwords are ignored.</string>
    <string name="perm_notification_access">Notification access</string>
    <string name="perm_notification_access_desc">Lets ASH organise bills, payments and deliveries</string>
    <string name="perm_on">On</string>
