    <string name="onb1_title">मिलिए ashOS से।</string>
    <string name="onb1_body">आप जिएँ, ashOS याद रखे। बिल, दस्तावेज़, डिलीवरी और समय-सीमाएँ, सब एक शांत जगह पर।</string>
    <string name="onb2_title">आपकी डिजिटल ज़िंदगी, व्यवस्थित।</string>
    <string name="onb2_body">आप जिन नोटिफ़िकेशन की अनुमति देते हैं, ashOS उन्हें साफ़ रिकॉर्ड में बदलता है और बताता है कि किस पर ध्यान देना है।</string>
    <string name="onb3_title">आपका डेटा इसी फ़ोन पर रहता है।</string>
    <string name="onb3_body">ashOS के पास इंटरनेट की अनुमति ही नहीं है। न क्लाउड, न अकाउंट, न एनालिटिक्स। सब कुछ आपके फ़ोन पर एन्क्रिप्टेड है और आप कभी भी सब हटा सकते हैं।</string>
    <string name="onb4_title">चुनें कि ashOS क्या देख सकता है।</string>
    <string name="onb4_body">आप तय करते हैं कि ashOS किन ऐप को पढ़े। सब कुछ वैकल्पिक है और बाद में सेटिंग में बदला जा सकता है।</string>

    <string name="perm_title">अनुमतियाँ चुनें</string>
    <string name="perm_intro">ashOS इनके बिना भी चलता है। हर अनुमति कुछ नया जोड़ती है और आप उसे बाद में बंद कर सकते हैं।</string>
    <string name="perm_notifications_header">नोटिफ़िकेशन</string>
    <string name="perm_notifications_footer">नोटिफ़िकेशन ऐक्सेस से ashOS नीचे चालू किए गए ऐप (जैसे बैंक SMS, Amazon, IRCTC) के नोटिफ़िकेशन इसी फ़ोन पर पढ़ता है और कहीं नहीं भेजता। OTP और पासवर्ड अनदेखे किए जाते हैं।</string>
    <string name="perm_notification_access">नोटिफ़िकेशन ऐक्सेस</string>
    <string name="perm_notification_access_desc">बिल, भुगतान और डिलीवरी अपने आप व्यवस्थित करें</string>
    <string name="perm_on">चालू</string>
    <string name="perm_sources">ashOS कौन से ऐप पढ़ सकता है</string>
    <string name="perm_sources_desc">%1$d चालू</string>
    <string name="perm_reminders_header">रिमाइंडर</string>
    <string name="perm_reminders_footer">ashOS नोटिफ़िकेशन का उपयोग सिर्फ़ ड्यू डेट और एक्सपायरी याद दिलाने के लिए करता है।</string>
    <string name="perm_post_notifications">रिमाइंडर की अनुमति दें</string>
    <string name="perm_post_notifications_desc">किसी काम की तारीख से पहले याद दिलाएँ</string>
    <string name="perm_camera_later">कैमरा सिर्फ़ दस्तावेज़ स्कैन करते समय माँगा जाता है।</string>

